# Twilio Agent Connect - Environment Variables
# Copy this file to .env and update with your values

# ============================================================================
# TAC Mode Selection (REQUIRED)
# ============================================================================
# Determines which features are enabled:
#   - "crelay": ConversationRelay-only mode (voice only, no Maestro)
#   - "conversation": Full Conversation mode (multi-channel, requires Maestro)
#   - "passive": Maestro-only mode (bring your own ConversationRelay server)
TAC_MODE=conversation

# ============================================================================
# Twilio Configuration (REQUIRED)
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ============================================================================
# TAC Framework - Conversation Orchestrator (Maestro)
# ============================================================================
# REQUIRED for TAC_MODE=conversation or passive
# This is a Conversation Orchestrator configuration ID (NOT Conversations API v1)
# Format: conv_configuration_*
# Create at: console.twilio.com/us1/develop/conversations/orchestration
CONVERSATION_SERVICE_ID=conv_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - Conversation Memory (Memora)
MEMORY_STORE_ID=mem_store_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - Voice Channel (full URL with https://)
VOICE_PUBLIC_DOMAIN=https://your-domain.ngrok.app

# ============================================================================
# Chat Example Only - Conversations API v1 (SDK Token Generation)
# ============================================================================
# ONLY needed for the chat example to generate Conversations SDK tokens
# This is a Conversations v1 Service SID (NOT Conversation Orchestrator)
# Format: IS*
# Create at: console.twilio.com/us1/develop/conversations/manage/services
TWILIO_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - OpenAI Example
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
