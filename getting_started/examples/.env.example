# Twilio Agent Connect - Environment Variables
# Copy this file to .env and update with your values


# ============================================================================
# Twilio Configuration (REQUIRED)
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ============================================================================
# TAC Framework - Conversation Orchestrator (Maestro)
# ============================================================================
# REQUIRED for all channels (Voice, SMS, Chat)
# This is a Conversation Orchestrator configuration ID (NOT Conversations API v1)
# Format: conv_configuration_*
# Create at: console.twilio.com/us1/develop/conversations/orchestration
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Public Domains (REQUIRED)
# ============================================================================
# The public host each server is reachable at from Twilio's side. Used for
# webhook signature validation and (for CR) WebSocket URL generation in
# the TwiML. Load balancers (AWS ALB, GCP LB) and default reverse-proxy
# configs (NGINX, Apache) rewrite the Host header to internal backend
# addresses, so URL reconstruction from request headers is unreliable —
# these values must be explicit.
#
# Accepts either a bare host or a full https:// URL; values are normalised.
# Two vars because the servers are independent and commonly live on
# different tunnels/hostnames. In a single-tunnel setup, set both to the
# same value.

# Required - TACServer (Conversation Orchestrator webhooks)
TAC_PUBLIC_DOMAIN=https://tac-<you>.ngrok.dev

# Required - ConversationRelayServer (voice: TwiML + WebSocket + call-end callback)
CR_PUBLIC_DOMAIN=https://cr-<you>.ngrok.dev

# Optional - Twilio Region (routes API requests to a specific region)
# TWILIO_REGION=

# ============================================================================
# Chat Example Only - Conversations API v1 (SDK Token Generation)
# ============================================================================
# ONLY needed for the chat example to generate Conversations SDK tokens
# This is a Conversations v1 Service SID (NOT Conversation Orchestrator)
# Format: IS*
# Create at: console.twilio.com/us1/develop/conversations/manage/services
TWILIO_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - OpenAI Example
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
